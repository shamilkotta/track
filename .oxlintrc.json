{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".nlite/**",
    ".next/**",
    "node_modules/**",
    "components/ui/**",
    "hooks/use-mobile.ts",
    "worker-configuration.d.ts",
    "drizzle/**"
  ]
}
