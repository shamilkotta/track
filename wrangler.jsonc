{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackr",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://trackr.shamilkotta.workers.dev",
    "EMAIL_FROM_NAME": "Trackr",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackr",
      "database_id": "1b19c01e-a058-44c7-bd91-427396f67243",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*.sql",
    },
  ],
  // clients tab: */15 retries undelivered client-hunter webhooks, 03:30 UTC = 09:00 IST cold sweep
  "triggers": {
    "crons": ["*/15 * * * *", "30 3 * * *"],
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "trackr-files",
    },
  ],
}
