{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trackr",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://trackr.shamilkotta.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackr",
      "database_id": "1b19c01e-a058-44c7-bd91-427396f67243",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*.sql",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "trackr-files",
    },
  ],
}
